{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "DOCKERFILE", "dockerfilePath": "Dockerfile" },
  "deploy": {
    "services": [
      {
        "name": "web",
        "startCommand": "sh -c \"python manage.py migrate --noinput && gunicorn config.wsgi:application --bind 0.0.0.0:$PORT\""
      },
      {
        "name": "worker",
        "startCommand": "python manage.py rqworker --with-scheduler"
      }
    ]
  }
}
